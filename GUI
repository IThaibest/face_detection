        % Button pushed function: Button
        function ButtonPushed(app, event)
[fileName, filePath] = uigetfile({'*.jpg;*.png;*.bmp;*.jpeg', '图片文件 (*.jpg, *.png, *.bmp, *.jpeg)'}, '选择一张图片');
    if fileName == 0
        uialert(app.UIFigure, '未选择图片。', '导入错误');
        app.isinputimgflag = false;
        return;
    end
    fullFilePath = fullfile(filePath, fileName);
    try
        app.imgtemp = imread(fullFilePath);
        app.originalImg = app.imgtemp; % 保存原始图像副本
        app.isinputimgflag = true;
        axes = subplot(1, 1, 1, 'Parent', app.ImagePanel);
        imshow(app.imgtemp, 'Parent', axes, 'InitialMagnification', 'fit');
        title('原图', 'Parent', axes, 'FontName', '宋体', 'FontSize', 16, 'Color', [1,1,1], 'FontWeight', 'bold');
    catch e
        uialert(app.UIFigure, sprintf('图片加载失败：%s', e.message), '导入错误');
        app.isinputimgflag = false;
        app.imgtemp = [];
        app.originalImg = [];
    end



        end

