        % Button pushed function: Button_9
        function Button_9Pushed(app, event)
           if app.isinputimgflag
        try
            % 从原始图像开始
            app.img = cell(1, 1);
            app.img{1} = app.originalImg;
            
            % 确保图像是灰度图像
            if ndims(app.img{1}) == 3 && size(app.img{1}, 3) == 3
                app.img{1} = rgb2gray(app.img{1});
            end
            
            % 应用平移
            shiftParams = str2num(app.TextArea.Value{1}); %#ok<ST2NM>
            if ~isempty(shiftParams)
                if length(shiftParams) ~= 2
                    error('平移参数格式错误，应为 [x, y]');
                end
                shiftX = shiftParams(1);
                shiftY = shiftParams(2);
                app.img{1} = imtranslate(app.img{1}, [shiftX, shiftY]);
            end
            
            % 应用缩放
            scale = str2double(app.TextArea_2.Value{1});
            if ~isnan(scale) && scale > 0
                app.img{1} = imresize(app.img{1}, scale);
            end
            
            % 应用旋转
            angle = str2double(app.TextArea_3.Value{1});
            if ~isnan(angle)
                app.img{1} = imrotate(app.img{1}, angle, 'bilinear', 'crop');
            end
            
            % 在 Panel_2 中显示处理后的图像
            axes = subplot(1, 1, 1, 'Parent', app.ImagePanel);
            imshow(app.img{1}, 'Parent', axes, 'InitialMagnification', 'fit');
            title('重置后图像', 'Parent', axes, 'FontName', '楷体', 'FontSize', 16, 'Color', [1,1,1], 'FontWeight', 'bold');
            
            % 检查是否在新窗口显示
            if strcmp(app.DropDown.Value, '是')
                figure;
                imshow(app.img{1});
                title('重置后图像', 'FontName', '楷体', 'FontSize', 16, 'Color', [0,0,0], 'FontWeight', 'bold');
            end
            
            % 更新 app.imgtemp
            app.imgtemp = app.img{1};
            
        catch e
            uialert(app.UIFigure, sprintf('重置失败：%s', e.message), '操作错误');
        end
    else
        uialert(app.UIFigure, '请先导入图片！', '操作错误');
    end
        end
