            function outputImg = ImgEqualing(app, inputImg)
    % 图像均衡化
    try
        if ndims(inputImg) == 3 && size(inputImg, 3) == 3
            % 如果是彩色图像，转换为灰度图像
            inputImg = rgb2gray(inputImg);
        end
        % 使用 MATLAB 的 histeq 函数进行直方图均衡化
        outputImg = histeq(inputImg);
    catch e
        error('均衡化处理失败：%s', e.message);
    end
end
        
        
 function [MaxVal, MinVal, Avr, Var] = GetImgParams(app, img)
    try
        % 验证输入图像是否有效
        if isempty(img)
            error('输入图像为空');
        end
        if ~ismatrix(img) && ~(ndims(img) == 3 && size(img, 3) == 3)
            error('输入图像格式无效，必须是灰度图像或RGB图像');
        end
        
        % 确保图像是灰度图像
        if ndims(img) == 3 && size(img, 3) == 3
            img = rgb2gray(img);
        end
        
        % 计算参数
        MaxVal = double(max(img(:)));
        MinVal = double(min(img(:)));
        Avr = mean(img(:), 'double');
        Var = var(double(img(:)));
    catch e
        error('获取图像参数失败：%s', e.message);
    end
end
        end
        
    
    

