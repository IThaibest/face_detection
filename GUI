            % 检查是否需要在外部窗口显示
            if strcmp(app.DropDown.Value, '是')
                % 在新窗口显示均衡化图像
                figure;
                imshow(app.img{1});
                title('均衡化图像', 'FontName', '楷体', 'FontSize', 16, 'Color', [0,0,0], 'FontWeight', 'bold');
            end
            
            % 更新 app.imgtemp 为均衡化后的图像
            app.imgtemp = app.img{1};
            
        catch e
            uialert(app.UIFigure, sprintf('均衡化失败：%s', e.message), '操作错误');
        end
    else
        uialert(app.UIFigure, '请先导入图片！', '操作错误');
    end
        end

        % Button pushed function: Button_5
        function Button_5Pushed(app, event)
if app.isinputimgflag
