        % Button pushed function: Button_3
        function Button_3Pushed(app, event)
            % 检查是否已加载图片
            if ~app.isinputimgflag
                uialert(app.UIFigure, '请先导入图片！', '操作错误');
                return;
            end
            
            try
                % 检查图像是否为 RGB 图像（3 个通道）
                if ndims(app.imgtemp) == 3 && size(app.imgtemp, 3) == 3
                    % 将 RGB 图像转换为灰度图像
                    grayImage = rgb2gray(app.imgtemp);
                else
                    % 如果已经是灰度图像，直接使用
                    grayImage = app.imgtemp;
                end
                
                % 更新 app.imgtemp 为灰度图像
                app.imgtemp = grayImage;
                
                % 在 Panel_2 中显示灰度图像
                axes = subplot(1, 1, 1, 'Parent', app.ImagePanel);
                imshow(app.imgtemp, 'Parent', axes, 'InitialMagnification', 'fit');
                title('灰度图像', 'Parent', axes, 'FontName', '宋体', 'FontSize', 16, 'Color', [1,1,1], 'FontWeight', 'bold');
                
            catch e
                % 处理灰度化过程中的错误
                uialert(app.UIFigure, sprintf('灰度化失败：%s', e.message), '操作错误');
            end
        end

        % Button pushed function: Button_4
        function Button_4Pushed(app, event)
          if app.isinputimgflag
        try
            % 初始化单元数组并存储当前图像
            app.img = cell(1, 1);
            app.img{1} = app.imgtemp;
            
            % 确保图像是灰度图像
            if ndims(app.img{1}) == 3 && size(app.img{1}, 3) == 3
                app.img{1} = rgb2gray(app.img{1});
            end
            
            % 调用图像均衡化方法
            app.img{1} = app.ImgEqualing(app.img{1});
            
            % 在 Panel_2 中显示均衡化图像
            axes = subplot(1, 1, 1, 'Parent', app.ImagePanel);
